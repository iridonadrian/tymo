# Copy to .env and adjust. Every setting is optional for local use.

# Password gate. Required whenever Tymo is reachable by anyone but you.
# Use 12+ characters (a few random words); exposed containers refuse fewer than 8.
TYMO_PASSWORD=
# Set to 0 once you set a password / expose the port.
TYMO_ALLOW_NO_AUTH=1
# Without a password, only localhost, 127.0.0.1, ::1 and IP addresses may be used to reach Tymo
# (protects against DNS-rebinding attacks). Add other hostnames here, comma-separated.
TYMO_ALLOWED_HOSTS=
# Public address of this server, e.g. https://tymo.example.com. Needed for the claude.ai
# connector (OAuth issuer and /mcp resource URLs); recommended whenever Tymo is behind a proxy.
TYMO_PUBLIC_URL=
# Set to 1 only behind a reverse proxy that sets X-Forwarded-For (used for login rate limits).
TYMO_TRUST_PROXY=
# Mark the session cookie Secure (set to 1 behind HTTPS if your proxy doesn't send X-Forwarded-Proto).
TYMO_SECURE_COOKIES=

# Where the SQLite database and uploads live (defaults to ./data, or /data in Docker).
TYMO_DATA_DIR=

# Optional AI — overrides values set in the UI. Providers: ollama | openai | anthropic | gemini
# Local Ollama (nothing leaves your machine):
#   TYMO_AI_PROVIDER=ollama   (outside Docker no URL is needed)
#   TYMO_AI_BASE_URL=http://host.docker.internal:11434/v1   (when Tymo runs in Docker)
TYMO_AI_PROVIDER=
TYMO_AI_BASE_URL=
TYMO_AI_MODEL=
TYMO_AI_API_KEY=
TYMO_AI_AUTO_SUGGEST=
# Semantic search / related saves / near-duplicates (1 = on). Uses the provider's embeddings API
# (OpenAI-compatible or Gemini). With Anthropic, point TYMO_AI_EMBEDDING_BASE_URL at an
# OpenAI-compatible server such as Ollama (http://127.0.0.1:11434/v1, model nomic-embed-text).
TYMO_AI_SEMANTIC=
TYMO_AI_EMBEDDING_MODEL=
TYMO_AI_EMBEDDING_BASE_URL=
# Understand images: describe them and read their text with a vision model (1 = on).
TYMO_AI_OCR=

# Archive an offline copy of every new web page (1 = on). Also configurable in Settings.
TYMO_AUTO_ARCHIVE=

# Write a full backup to DATA_DIR/backups once a day (1 = on). Also configurable in Settings.
TYMO_AUTO_BACKUP=

# Where automatic backups go (default DATA_DIR/backups). Point it at a synced folder or an
# external disk (iCloud Drive, Dropbox, Google Drive…) so a copy survives losing the machine.
TYMO_BACKUP_DIR=

# Check saved links for rot in the background (1 = on). Also configurable in Settings.
TYMO_LINK_CHECK=

# DANGER: allows metadata fetches to private/intranet addresses (disables SSRF protection).
TYMO_UNSAFE_ALLOW_PRIVATE_FETCH=
