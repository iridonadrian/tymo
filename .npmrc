# Supply-chain guards. Older npm versions ignore keys they don't know.
# Dependencies' install scripts never run (none of ours need them; see docs/THREAT_MODEL.md).
ignore-scripts=true
# Only install versions published at least 7 days ago: hijacked releases are usually
# caught and pulled within days. For an urgent security fix: --min-release-age=0
min-release-age=7
# No dependencies straight from git repositories.
allow-git=none
